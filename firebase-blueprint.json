{
  "entities": {
    "user": {
      "title": "UserProfile",
      "description": "User preferences and tracking metrics",
      "type": "object",
      "properties": {
        "displayName": {
          "type": "string",
          "description": "Real name display name"
        },
        "dailySignsGoal": {
          "type": "integer",
          "description": "Signs goal count"
        },
        "experienceLevel": {
          "type": "string",
          "description": "Skill experience level of practice"
        },
        "preferredPracticeTime": {
          "type": "string",
          "description": "Preferred practice hour"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp when updated"
        }
      }
    },
    "backup": {
      "title": "UserBackup",
      "description": "Cloud backup of practice logs and webcam coordinates",
      "type": "object",
      "properties": {
        "sessions": {
          "type": "array",
          "description": "Past interactive session logs"
        },
        "samples": {
          "type": "array",
          "description": "Collected 3D hand coordinates landmarks"
        },
        "backedUpAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of backup creation"
        },
        "totalSessions": {
          "type": "integer"
        },
        "totalSamples": {
          "type": "integer"
        }
      }
    },
    "dataset": {
      "title": "DatasetItem",
      "description": "Webcam gestures landmark coordinate packages",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "samples": {
          "type": "array"
        },
        "categories": {
          "type": "array"
        },
        "sampleStatistics": {
          "type": "object"
        },
        "size": {
          "type": "string"
        },
        "ownerId": {
          "type": "string"
        },
        "ownerEmail": {
          "type": "string"
        }
      }
    },
    "customGesture": {
      "title": "CustomGesture",
      "description": "User-authored gesture definition mapping custom labels",
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "Unique gesture identifier"
        },
        "char": {
          "type": "string",
          "description": "Custom tag or label uppercase"
        },
        "description": {
          "type": "string",
          "description": "Text description of hand coordinates shape"
        },
        "category": {
          "type": "string",
          "description": "Defaults to 'custom'"
        },
        "visualTip": {
          "type": "string",
          "description": "Aesthetic hint for users trying to match the pose"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp"
        }
      }
    },
    "faceProfile": {
      "title": "FaceProfile",
      "description": "Secure face recognition login snapshot and registration metadata",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "User identifier"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "enrolledFace": {
          "type": "string",
          "description": "Base64 string of the registered face image"
        },
        "enrolledAt": {
          "type": "string",
          "format": "date-time",
          "description": "ISO timestamp of face enrollment"
        }
      }
    },
    "predictionFeedback": {
      "title": "PredictionFeedback",
      "description": "User corrections and feedback for wrong AI gesture predictions",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "predictedChar": {
          "type": "string",
          "description": "The incorrect AI prediction label"
        },
        "correctLabel": {
          "type": "string",
          "description": "The correct human ground-truth label"
        },
        "confidence": {
          "type": "number",
          "description": "AI confidence score percentage"
        },
        "predictionSource": {
          "type": "string",
          "description": "Source engine (e.g. tensorflow, heuristics, simulated)"
        },
        "notes": {
          "type": "string",
          "description": "User notes or description of wrong prediction context"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "userId": {
          "type": "string"
        },
        "userEmail": {
          "type": "string"
        },
        "status": {
          "type": "string",
          "enum": ["pending_review", "corrected", "applied"]
        }
      },
      "required": ["id", "predictedChar", "correctLabel", "createdAt"]
    },
    "aiModel": {
      "title": "AIModel",
      "description": "Cloud-stored neural network AI model with topology, serialized weights, classes, and metadata",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "version": {
          "type": "string"
        },
        "releaseTag": {
          "type": "string",
          "enum": ["stable", "candidate", "experimental", "deprecated"]
        },
        "architecture": {
          "type": "string"
        },
        "framework": {
          "type": "string"
        },
        "classes": {
          "type": "array"
        },
        "epochs": {
          "type": "integer"
        },
        "accuracy": {
          "type": "number"
        },
        "loss": {
          "type": "number"
        },
        "valAccuracy": {
          "type": "number"
        },
        "valLoss": {
          "type": "number"
        },
        "sampleCount": {
          "type": "integer"
        },
        "modelTopology": {
          "type": "object"
        },
        "weightSpecs": {
          "type": "array"
        },
        "weightData": {
          "type": "string",
          "description": "Base64-encoded binary weight buffers or manifest"
        },
        "tags": {
          "type": "array"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time"
        },
        "authorUid": {
          "type": "string"
        },
        "authorEmail": {
          "type": "string"
        },
        "isPublic": {
          "type": "boolean"
        },
        "versionCount": {
          "type": "integer"
        },
        "latestVersionId": {
          "type": "string"
        }
      },
      "required": ["id", "name", "classes", "createdAt"]
    },
    "modelVersion": {
      "title": "ModelVersion",
      "description": "Version control record representing a specific commit or snapshot of an AI model",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "modelId": {
          "type": "string"
        },
        "versionNumber": {
          "type": "string"
        },
        "commitMessage": {
          "type": "string"
        },
        "releaseTag": {
          "type": "string",
          "enum": ["stable", "candidate", "experimental", "deprecated"]
        },
        "accuracy": {
          "type": "number"
        },
        "loss": {
          "type": "number"
        },
        "valAccuracy": {
          "type": "number"
        },
        "valLoss": {
          "type": "number"
        },
        "epochs": {
          "type": "integer"
        },
        "classes": {
          "type": "array"
        },
        "architecture": {
          "type": "string"
        },
        "weightData": {
          "type": "string"
        },
        "modelTopology": {
          "type": "object"
        },
        "changeLog": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "authorUid": {
          "type": "string"
        }
      },
      "required": ["id", "modelId", "versionNumber", "createdAt"]
    },
    "modelBackup": {
      "title": "ModelBackup",
      "description": "Comprehensive point-in-time cloud backup snapshot containing all models, version trees, and weights",
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time"
        },
        "totalModels": {
          "type": "integer"
        },
        "modelsSnapshot": {
          "type": "array"
        },
        "backupType": {
          "type": "string",
          "enum": ["manual", "automated_pre_train", "scheduled"]
        },
        "checksum": {
          "type": "string"
        },
        "sizeBytes": {
          "type": "integer"
        }
      },
      "required": ["id", "createdAt", "modelsSnapshot"]
    }
  },
  "firestore": {
    "cloud_models/{modelId}": {
      "schema": "aiModel",
      "description": "Community and verified cloud repository of sign language AI models"
    },
    "prediction_feedback/{feedbackId}": {
      "schema": "predictionFeedback",
      "description": "Global collection for user-submitted gesture prediction feedback and corrections"
    },
    "users/{userId}": {
      "schema": "user",
      "description": "Root user settings profiles"
    },
    "face_profiles/{userId}": {
      "schema": "faceProfile",
      "description": "Enrolled Face ID data for users"
    },
    "users/{userId}/backups/{backupId}": {
      "schema": "backup",
      "description": "Backup logs stored under uid"
    },
    "users/{userId}/model_backups/{backupId}": {
      "schema": "modelBackup",
      "description": "Full cloud backup snapshots of AI models and weights"
    },
    "users/{userId}/models/{modelId}": {
      "schema": "aiModel",
      "description": "User stored cloud AI models with weights and topologies"
    },
    "users/{userId}/models/{modelId}/versions/{versionId}": {
      "schema": "modelVersion",
      "description": "Version control history commits for user AI models"
    },
    "users/{userId}/datasets/{datasetId}": {
      "schema": "dataset",
      "description": "Interactive collections of sign coordinates datasets"
    },
    "users/{userId}/gestures/{gestureId}": {
      "schema": "customGesture",
      "description": "Saved user-created customized gestures and postures labels"
    },
    "users/{userId}/prediction_feedback/{feedbackId}": {
      "schema": "predictionFeedback",
      "description": "User specific submitted prediction corrections and feedback"
    }
  }
}
