# ==================================================================
# DOCKER & CONTAINER ENVIRONMENT VARIABLES CONFIGURATION
# ==================================================================

# GEMINI_API_KEY: Required for Gemini AI vision, translation & speech API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The public URL where the frontend applet is hosted.
APP_URL="http://localhost:3000"

# SERVER PORT SETTINGS
# Port 3000 for Node.js Express Frontend & REST API
PORT=3000
NODE_ENV=production

# BACKEND CONNECTION CONFIGURATION (Python FastAPI & WebSockets)
# ------------------------------------------------------------------
# VITE_API_URL: The URL of the FastAPI backend service (e.g. http://localhost:8000 or http://backend:8000 in Docker)
VITE_API_URL="http://localhost:8000"

# VITE_WS_URL: The WebSocket endpoint URL of the FastAPI backend service (e.g. ws://localhost:8000/ws)
VITE_WS_URL="ws://localhost:8000/ws"
